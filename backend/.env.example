PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Tasa de cambio USD -> DOP usada para convertir montos en dólares
USD_TO_DOP_RATE=60.0

# Credenciales de Google Cloud Console (Para lectura de Gmail)
# Obténlas gratis en https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Base de datos Supabase (PostgreSQL Cloud para persistencia indestructible)
# Obténlas gratis en https://supabase.com/ -> Tu Proyecto -> Project Settings -> API
# Usa la clave "service_role" (NO la "anon", que es pública) y activa RLS en supabase_schema.sql
SUPABASE_URL=
SUPABASE_KEY=
# Alternativa equivalente a SUPABASE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# 2FA fijo por variable de entorno (opcional). Si se define el secreto sin códigos
# de respaldo, se generan códigos aleatorios.
GASTABIEN_2FA_SECRET=
# Lista separada por comas, ej: AB12-CD34,EF56-7890
GASTABIEN_2FA_BACKUP_CODES=

# Respaldo JSON completo del store (opcional, último recurso si no hay Supabase ni archivo local)
GASTABIEN_STORE_DATA=
